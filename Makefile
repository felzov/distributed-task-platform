.RECIPEPREFIX = >

.PHONY: install lint format typecheck test test-integration check check-all \
	db-up db-down db-migrate db-revision

install:
> uv sync

lint:
> uv run ruff check .
> uv run ruff format --check .

format:
> uv run ruff format .
> uv run ruff check --fix .

typecheck:
> uv run mypy

# Unit tests; no database or broker needed.
test:
> uv run pytest -m "not integration"

# Needs PostgreSQL (`make db-up`) and TEST_DATABASE_URL; fails instead of skipping without them.
test-integration:
> uv run pytest -m integration

# What CI runs on each Python version (CI also scans git history for secrets).
check: lint typecheck test

check-all: check test-integration

# Starts PostgreSQL and waits until its healthcheck passes.
db-up:
> docker compose up -d --wait

# Stops the containers and keeps the data volume. Deleting it (`down -v`) is a manual decision.
db-down:
> docker compose down

db-migrate:
> uv run alembic upgrade head

# Creates an empty revision to write by hand (never autogenerated): make db-revision id=0002 m="..."
db-revision:
> @test -n "$(id)" -a -n "$(m)" || { echo 'usage: make db-revision id=0002 m="what it does"'; exit 1; }
> uv run alembic revision --rev-id "$(id)" -m "$(m)"

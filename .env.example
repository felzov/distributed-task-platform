# Copy to .env (never committed) and replace every change-me with your own local password.
# Passwords inside the URLs must be URL-encoded if they contain special characters.

# docker compose: passwords of the local PostgreSQL and RabbitMQ containers. Both are applied only
# when the container's volume is first created.
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# App and `make db-migrate`.
DATABASE_URL=postgresql+asyncpg://task_platform:change-me@127.0.0.1:5432/task_platform

# Dispatcher and worker (the API does not use it).
BROKER_URL=amqp://task_platform:change-me@127.0.0.1:5672/

# `make test-integration`. The database name must end in _test. Broker tests declare and delete
# queues of their own with unique names, so they can share the local broker.
TEST_DATABASE_URL=postgresql+asyncpg://task_platform:change-me@127.0.0.1:5432/task_platform_test
TEST_BROKER_URL=amqp://task_platform:change-me@127.0.0.1:5672/

# Optional overrides (defaults shown; placeholders, not measured values).
# DB_CONNECT_TIMEOUT_S=5.0
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_COMMAND_TIMEOUT_S=10.0    # must be longer than DB_STATEMENT_TIMEOUT_MS
# DB_POOL_SIZE=5
# DB_POOL_TIMEOUT_S=5.0
# READY_CHECK_TIMEOUT_S=2.0
# MAX_PAYLOAD_BYTES=65536
# MAX_REQUEST_BODY_BYTES=131072
# DEFAULT_MAX_ATTEMPTS=5
# BROKER_CONNECT_TIMEOUT_S=5.0
# BROKER_HEARTBEAT_S=60
# JOBS_QUEUE_NAME=jobs
# DISPATCH_BATCH_SIZE=100      # 1 to 1000
# DISPATCH_POLL_INTERVAL_S=1.0
# PUBLISH_TIMEOUT_S=2.0        # must be shorter than DB_STATEMENT_TIMEOUT_MS
# LEASE_DURATION_S=120.0       # below 1800 (RabbitMQ's default consumer_timeout)
# HANDLER_TIMEOUT_S=60.0       # must be shorter than LEASE_DURATION_S
# WORKER_DB_ERROR_BACKOFF_S=5.0  # below 1800
# RETRY_BASE_DELAY_S=2.0      # must not exceed RETRY_MAX_DELAY_S
# RETRY_MAX_DELAY_S=300.0     # at most 86400 (one day)
# LOST_MESSAGE_AFTER_S=600.0  # at most 86400 (one day)
# The dispatcher and the worker must share DB_STATEMENT_TIMEOUT_MS: a worker's claim can wait on
# the dispatcher's row locks for PUBLISH_TIMEOUT_S plus the mark and commit, under the worker's
# statement timeout.
